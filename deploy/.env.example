# Blattwerk host configuration: copy to .env next to docker-compose.yml (mode 600), fill in, then run
# switch.sh (docs/self-hosting.md). switch.sh adds the generated values itself: the database passwords,
# the web push (VAPID) keys, the InfluxDB token, the image names and BW_LAT_KM/BW_LON_KM. Never commit a .env.

# --- required -------------------------------------------------------------------------------------------
# Claude Code OAuth token (`claude setup-token` on a machine with Claude Code): care plans, plant ID,
# plant doctor and chat. Without it the app works, the AI features say they are not set up.
CLAUDE_CODE_OAUTH_TOKEN=

# --- optional: weather (DWD forecast + frost/heat alerts) ------------------------------------------------------
# Where the garden is, in decimal degrees (about 1 km is enough; only the rounded values leave the host).
BW_LAT=
BW_LON=

# --- optional: own sensors from Home Assistant (Telegraf polls them into InfluxDB) ---------------------------
# A long-lived token of a dedicated, non-admin HA user. The compose file maps `homeassistant-host` to this
# Docker host; use your own URL when Home Assistant runs elsewhere.
BW_HA_URL=
BW_HA_TOKEN=
# entity ids (sensor.xyz), each optional
BW_HA_OUTDOOR=
BW_HA_GREENHOUSE=
BW_HA_RAIN_DAY=
BW_HA_RAIN_RATE=
BW_HA_WIND=
BW_HA_GUST=
BW_HA_SOLAR=
BW_HA_SOIL_1=
BW_HA_SOIL_1_LABEL=
BW_HA_SOIL_2=
BW_HA_SOIL_2_LABEL=
BW_HA_SOIL_3=
BW_HA_SOIL_3_LABEL=
BW_HA_SOIL_4=
BW_HA_SOIL_4_LABEL=

# --- optional: limits ------------------------------------------------------------------------------------------
# Care plans per day for the whole household (each costs a few cents of the Claude account).
BW_PLAN_DAILY_LIMIT=60

# --- without Traefik (docs/self-hosting.md) --------------------------------------------------------------------
# COMPOSE_FILE=docker-compose.yml:standalone.override.yml
